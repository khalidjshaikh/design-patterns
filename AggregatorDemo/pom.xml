<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.artificialintelligence.patterns</groupId>
    <artifactId>aggregator-demo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Aggregator Demo</name>
    <description>Empty main class for the Design Patterns Aggregator.</description>

    <properties>
        <maven.compiler.release>27</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration>
                    <mainClass>com.artificialintelligence.patterns.aggregator.Demo</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>